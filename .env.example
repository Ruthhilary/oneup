# Copy this file to ".env" and fill in your real keys. The .env file is gitignored.
# Run locally with:  npm start   (it auto-loads .env)
# On Render, set these in the service's Environment tab instead of using a file.

# --- Google Maps (real ride distances) ---
# Only the SERVER key is needed for distances right now.
GOOGLE_MAPS_SERVER_KEY=
# Optional, for a live map / address autocomplete later:
GOOGLE_MAPS_BROWSER_KEY=

# --- Paystack (payments) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Email (Resend) — verification + password reset ---
RESEND_API_KEY=
MAIL_FROM=OneUp <onboarding@resend.dev>

# --- SMS (Termii, optional) — phone verification ---
TERMII_API_KEY=
TERMII_SENDER=OneUp

# --- App ---
# Your public URL (used for payment return + reset links). Leave blank for localhost.
APP_URL=
# Set in production so the admin key can't be left at its default:
# ADMIN_KEY=choose-a-strong-secret
